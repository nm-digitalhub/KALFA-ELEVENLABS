<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Network. Previously undeclared: the app only reached the network because
      ktor/okhttp merge INTERNET in from their library manifests. Declared here so
      the dependency is explicit rather than inherited.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Live-agent VoIP audio (Voximplant human-agent leg — monitor / takeover).
      RECORD_AUDIO is runtime-sensitive and requested at the live-supervision surface
      (telephony/CallAudioPermissions); the console genuinely carries two-way voice on
      takeover, not for convenience.

      Foreground service: v1 keeps an active call alive with a `microphone`-typed FGS
      (telephony/CallForegroundService) — deliberately NOT a `phoneCall` FGS.
      `phoneCall` on Android 14+ additionally requires self-managed Telecom
      (MANAGE_OWN_CALLS + a ConnectionService) OR the default-dialer role; that
      option-(a) path is deferred to the telephony-wiring step. So MANAGE_OWN_CALLS and
      FOREGROUND_SERVICE_PHONE_CALL are intentionally NOT declared yet — declaring
      sensitive permissions with no matching phoneCall service is a Play-review risk.
      They return together with the ConnectionService below when Telecom is adopted.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 12+ (API 31) Bluetooth headset routing. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      Presence foreground service (docs/android-presence-and-call-ux.md §1): required
      alongside the specialUse foreground-service type declared below. No closer-fitting
      type exists — the heartbeat has no audio/location/bulk-data-transfer, and
      `phoneCall` requires the self-managed Telecom this app deliberately does not
      adopt yet (see the doc's "Decision: android.telecom adoption").
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Microphone is required for the console to function; not an optional feature. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MyApplication">
            <!--
              singleTask (docs/android-presence-and-call-ux.md §3): a locked-device
              incoming-call full-screen intent re-targets this SAME activity via
              onNewIntent instead of stacking a second instance. Single-activity app —
              no back-stack semantics change from this.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Ongoing-call foreground service (v1, option-b). Keeps an active monitor/
          takeover leg alive with a `microphone`-typed FGS + ongoing notification.
          Not exported; started only in-process by the telephony-wiring step. Switches
          to (or is complemented by) the ConnectionService below when self-managed
          Telecom is adopted.
        -->
        <service
            android:name=".telephony.CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!--
          Push wake-up (AGENTS.md "Push wake-up"): Voximplant sends a Firebase
          data-message push when callUser is invoked for an agent whose device is
          backgrounded or killed. Not exported — only the FCM system component
          delivers to it, gated by the standard MESSAGING_EVENT action.
        -->
        <service
            android:name=".telephony.vox.VoxFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
          Presence foreground service (docs/android-presence-and-call-ux.md §1) — the
          fix for AgentPresence.setStatus writing once and never again. specialUse: no
          audio, no location, no bulk data transfer, and phoneCall needs the
          self-managed Telecom this app doesn't adopt yet (see the doc's Telecom
          decision). Requires a Play Console justification before any Play
          distribution (owner action, not blocking today — no upload keystore yet).
        -->
        <service
            android:name=".telephony.presence.PresenceForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a call-center agent's on-shift presence heartbeat alive so the server can route inbound and AI-escalated calls to this device while the app is backgrounded" />
        </service>

        <!--
          Notification action receivers (docs §1 and §3). Not exported — only this
          app's own PendingIntents target them.
        -->
        <receiver android:name=".telephony.presence.PresenceActionReceiver" android:exported="false" />
        <receiver android:name=".telephony.vox.IncomingCallActionReceiver" android:exported="false" />
        <receiver android:name=".telephony.CallHangupActionReceiver" android:exported="false" />

        <!--
          Self-managed ConnectionService (AGENTS.md §3). Register the PhoneAccount
          with CAPABILITY_SELF_MANAGED at runtime; Telecom owns audio focus and
          routing during a call, so this must exist before real audio is wired.
          TODO(voximplant-phase): implement me.kalfa.agentconsole.telephony.ConsoleConnectionService
          and remove tools:ignore once the class lands.
        -->
        <!--
        <service
            android:name=".telephony.ConsoleConnectionService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>
        -->
    </application>

</manifest>
