<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Network. Previously undeclared: the app only reached the network because
      ktor/okhttp merge INTERNET in from their library manifests. Declared here so
      the dependency is explicit rather than inherited.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Live-agent VoIP audio (Voximplant human-agent leg — monitor / takeover).
      RECORD_AUDIO is runtime-sensitive and requested at the live-supervision surface
      (telephony/CallAudioPermissions); the console genuinely carries two-way voice on
      takeover, not for convenience.

      Foreground service: v1 keeps an active call alive with a `microphone`-typed FGS
      (telephony/CallForegroundService) — deliberately NOT a `phoneCall` FGS.
      `phoneCall` on Android 14+ additionally requires self-managed Telecom
      (MANAGE_OWN_CALLS + a ConnectionService) OR the default-dialer role; that
      option-(a) path is deferred to the telephony-wiring step. So MANAGE_OWN_CALLS and
      FOREGROUND_SERVICE_PHONE_CALL are intentionally NOT declared yet — declaring
      sensitive permissions with no matching phoneCall service is a Play-review risk.
      They return together with the ConnectionService below when Telecom is adopted.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 12+ (API 31) Bluetooth headset routing. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Microphone is required for the console to function; not an optional feature. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Ongoing-call foreground service (v1, option-b). Keeps an active monitor/
          takeover leg alive with a `microphone`-typed FGS + ongoing notification.
          Not exported; started only in-process by the telephony-wiring step. Switches
          to (or is complemented by) the ConnectionService below when self-managed
          Telecom is adopted.
        -->
        <service
            android:name=".telephony.CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!--
          Self-managed ConnectionService (AGENTS.md §3). Register the PhoneAccount
          with CAPABILITY_SELF_MANAGED at runtime; Telecom owns audio focus and
          routing during a call, so this must exist before real audio is wired.
          TODO(voximplant-phase): implement me.kalfa.agentconsole.telephony.ConsoleConnectionService
          and remove tools:ignore once the class lands.
        -->
        <!--
        <service
            android:name=".telephony.ConsoleConnectionService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>
        -->
    </application>

</manifest>
