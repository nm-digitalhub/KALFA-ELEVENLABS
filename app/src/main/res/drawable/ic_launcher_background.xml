<?xml version="1.0" encoding="utf-8"?>
<!--
  KALFA adaptive-icon background: solid brand orange.

  Source of truth for the mark is the web app's PWA icon
  (KALFA beta repo: public/icons/icon.svg), whose field is #FF5A3C -
  the same value the PWA manifest publishes as theme_color.

  The whole 108x108dp canvas is painted deliberately. Only a 66dp-diameter
  circle centred on the canvas (33dp radius) is guaranteed to survive every
  OEM mask - not a 66x66dp square, which is how Android's own diagrams
  simplify it, but OEM masks are only guaranteed convex and may cut in as
  close as 33dp from centre along any radius, including the diagonals. The
  outer margin exists to be cropped and to drive parallax, so the background
  has to bleed to the full 108x108 edge or a circular (or any non-square)
  mask would expose bare corners.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FF5A3C"
        android:pathData="M0,0h108v108h-108z" />
</vector>
