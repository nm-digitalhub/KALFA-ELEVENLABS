<?xml version="1.0" encoding="utf-8"?>
<!--
  KALFA adaptive-icon foreground: the "K" mark.

  The pathData below is copied VERBATIM from the web app's PWA icon
  (KALFA beta repo: public/icons/icon.svg) and is therefore still expressed in
  that file's 512x512 coordinate space. The <group> maps it onto Android's
  108x108dp canvas instead of re-typing the coordinates, so the shape stays
  provably identical to the source - diff the two strings to confirm.

  Geometry (all figures from the adaptive-icon spec):
    glyph bounding box in 512-space is x[130,400] y[136,376] = 270 x 240,
    centred on (265,256).

    scaleX/Y = 60 / 270 = 0.2222222  -> renders 60 x 53.33dp, inside the
                                        documented 48-66dp logo range.
    translateX = 54 - 265 * 0.2222222 = -4.888889
    translateY = 54 - 256 * 0.2222222 = -2.888889

  A group's matrix applies scale before translate (pivot defaults to 0,0), so a
  point maps to s*p + t. That puts the mark at x[24,84] y[27.33,80.67] - fully
  inside the 66x66dp safe zone (x,y in [21,87]) that no OEM mask ever clips,
  and centred on the canvas so circular and squircle masks both read straight.

  ic_launcher.xml also references this drawable as the <monochrome> layer: the
  system replaces the fill when theming icons on Android 13+, and the shape is
  already sized for the safe zone, so a separate silhouette would be redundant.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.2222222"
        android:scaleY="0.2222222"
        android:translateX="-4.888889"
        android:translateY="-2.888889">
        <path
            android:fillColor="#FFFDF8"
            android:pathData="M130 136h74v103l100-103h91L281 250l119 126h-96l-100-111v111h-74V136Z" />
    </group>
</vector>
