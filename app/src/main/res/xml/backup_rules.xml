<?xml version="1.0" encoding="utf-8"?>
<!--
  Referenced by android:fullBackupContent, and applies only below API 31 — from
  Android 12 the platform reads data_extraction_rules.xml instead. Inert either
  way while the manifest sets android:allowBackup="false", which it does.

  Same reasoning as data_extraction_rules.xml: this was the untouched Android
  Studio template, excluding nothing, on an app that stores a Supabase session
  and Voximplant tokens. Kept as an explicit deny so backup cannot silently
  become allow-all again if someone re-enables it.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
