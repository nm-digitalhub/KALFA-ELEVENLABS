<?xml version="1.0" encoding="utf-8"?>
<!--
  Referenced by android:dataExtractionRules, but INERT while the manifest sets
  android:allowBackup="false" — which it does, deliberately.

  Was the untouched Android Studio template: every rule commented out, excluding
  nothing, while the app stores a Supabase session, Voximplant access/refresh
  tokens (telephony/vox/VoxTokenStore) and presence state in app-private storage.
  `gplay preflight` flagged the combination on the built AAB (2026-08-14) and it
  was right to: with backup on and no exclusions, an adb backup or a device
  transfer carried an agent's live credentials off the device.

  Kept as an explicit deny rather than deleted, so that anyone who turns backup
  back on inherits a safe default instead of the template's silent allow-all.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
